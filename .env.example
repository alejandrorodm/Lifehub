# Copia este archivo a .env si quieres sobreescribir los valores por defecto.
# Ninguna de estas variables es un secreto.

# Host y puerto del servidor (API + estáticos en producción)
LIFEHUB_HOST=127.0.0.1
LIFEHUB_PORT=3131

# Puerto del servidor de desarrollo de Vite (cliente)
LIFEHUB_CLIENT_PORT=5173

# Directorio donde se guardan la base de datos y las copias de seguridad.
# Por defecto: ~/.local/share/lifehub
# LIFEHUB_DATA_DIR=/ruta/personalizada

# --- Reservado para una fase futura: asistente local con Ollama ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5
